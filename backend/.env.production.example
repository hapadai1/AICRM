# AICRM 운영(온프레미스) 환경변수 예시 — /opt/aicrm/backend/.env 로 복사해 값을 채운다.
# 이 파일에는 실제 비밀값을 쓰지 않는다(.env는 .gitignore 대상).

# PostgreSQL — 운영 DB. 개발용 aicrm_dev와 반드시 다른 이름을 쓴다.
DATABASE_URL="postgresql://aicrm:CHANGE_ME@localhost:5432/aicrm"

# JWT 서명 키 — 반드시 교체한다. 생성 예: openssl rand -base64 48
# 이 값이 바뀌면 발급된 액세스 토큰이 전부 무효가 되어 전 사용자가 재로그인한다.
JWT_SECRET="CHANGE_ME"
JWT_ACCESS_EXPIRES="30m"
REFRESH_TOKEN_DAYS="14"

# 업로드 파일 저장 경로 — 계약서·작업지시서·채촌 사진이 쌓인다.
# systemd 유닛의 ReadWritePaths와 backup.sh 대상이 이 경로다(바꾸면 둘 다 함께 수정).
FILE_STORAGE_PATH="/var/lib/aicrm/storage"

PORT=3000

# 데모 전용 스위치 — 운영에서는 반드시 비워 둔다.
DEMO_ALIMTALK_FAIL_PHONES=""
