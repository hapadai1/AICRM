// =============================================================================
// AICRM Prisma Schema
// 기준 문서: 02_AICRM_데이터모델설계서_v0.1 (16장 테이블 전체 목록)
//
// [주의] rental_allocations 기간 중복 방지 EXCLUDE 제약(문서 11.6)은 Prisma로
// 표현할 수 없으므로 마이그레이션 SQL에 아래 구문을 수기로 추가해야 한다:
//
//   CREATE EXTENSION IF NOT EXISTS btree_gist;
//   ALTER TABLE rental_allocations
//     ADD CONSTRAINT rental_allocation_no_overlap EXCLUDE USING gist (
//       rental_inventory_item_id WITH =,
//       daterange(pickup_date, availability_end_date, '[]') WITH &&
//     ) WHERE (status <> 'CANCELLED');
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. 기반: 사용자·권한
// -----------------------------------------------------------------------------

model User {
  id           String    @id @db.Uuid
  loginId      String    @unique @map("login_id") @db.VarChar(80)
  displayName  String    @map("display_name") @db.VarChar(80)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  status       String    @default("ACTIVE") @map("status") @db.VarChar(20)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  rowVersion   Int       @default(0) @map("row_version")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles                   UserRole[]
  refreshTokens               RefreshToken[]
  idempotencyKeys             IdempotencyKey[]
  auditLogs                   AuditLog[]
  consultations               Consultation[]               @relation("ConsultationStaff")
  confirmedContractVersions   ContractVersion[]            @relation("ContractVersionConfirmedBy")
  createdContractVersions     ContractVersion[]            @relation("ContractVersionCreatedBy")
  createdOptionSetVersions    OptionSetVersion[]           @relation("OptionSetVersionCreatedBy")
  optionSelectionValues       OptionSelectionValue[]       @relation("OptionSelectionValueSelectedBy")
  createdMeasurementSessions  MeasurementSession[]         @relation("MeasurementSessionCreatedBy")
  linkedOrderItemMeasurements OrderItemMeasurement[]       @relation("OrderItemMeasurementLinkedBy")
  issuedWorkOrderVersions     WorkOrderVersion[]           @relation("WorkOrderVersionIssuedBy")
  productionEvents            ProductionEvent[]            @relation("ProductionEventActor")
  assignedRentalAllocations   RentalAllocation[]           @relation("RentalAllocationAssignedBy")
  rentalAllocationEvents      RentalAllocationEvent[]      @relation("RentalAllocationEventActor")
  rentalAllocationNotes       RentalAllocationNote[]       @relation("RentalAllocationNoteActor")
  rentalInventoryStatusEvents RentalInventoryStatusEvent[] @relation("RentalInventoryStatusEventActor")
  repairStatusEvents          RepairStatusEvent[]          @relation("RepairStatusEventActor")
  targetedSharedNotes         SharedNote[]                 @relation("SharedNoteTarget")
  authoredSharedNotes         SharedNote[]                 @relation("SharedNoteAuthor")
  dashboardTaskActions        DashboardTaskAction[]        @relation("DashboardTaskActionActionBy")
  journeyEvents               JourneyEvent[]               @relation("JourneyEventActor")
  journeyItemCompletions      JourneyStageItemCompletion[] @relation("JourneyItemCompletionActor")

  @@map("users")
}

model Role {
  id          String   @id @db.Uuid
  code        String   @unique @map("code") @db.VarChar(50)
  name        String   @map("name") @db.VarChar(80)
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @db.Uuid
  code        String   @unique @map("code") @db.VarChar(80)
  name        String   @map("name") @db.VarChar(100)
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// 1. 기반: 파일·감사로그
// -----------------------------------------------------------------------------

model File {
  id             String   @id @db.Uuid
  storageKey     String   @unique @map("storage_key") @db.VarChar(255)
  originalName   String   @map("original_name") @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  sizeBytes      BigInt   @map("size_bytes")
  checksumSha256 String?  @map("checksum_sha256") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entityFiles               EntityFile[]
  optionChoices             OptionChoice[]
  workOrderVersionOutputs   WorkOrderVersion[]
  contractVersionSignatures ContractVersion[]  @relation("ContractVersionSignature")
  contractVersionExcels     ContractVersion[]  @relation("ContractVersionExcel")

  @@map("files")
}

model EntityFile {
  id         String   @id @db.Uuid
  fileId     String   @map("file_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  purpose    String   @map("purpose") @db.VarChar(30)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  file File @relation(fields: [fileId], references: [id])

  @@index([entityType, entityId])
  @@map("entity_files")
}

model AuditLog {
  id         String   @id @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @map("action") @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String   @map("entity_id") @db.Uuid
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  reason     String?  @map("reason")
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// 2. 고객·예약·상담
// -----------------------------------------------------------------------------

model Customer {
  id              String    @id @db.Uuid
  name            String    @map("name") @db.VarChar(80)
  phone           String    @map("phone") @db.VarChar(30)
  phoneNormalized String    @unique @map("phone_normalized") @db.VarChar(20)
  email           String?   @map("email") @db.VarChar(255)
  customerStatus  String    @default("PROSPECT") @map("customer_status") @db.VarChar(20)
  /// 고객으로 등록된 시각. 예약 자동생성분을 포함해 모든 고객 행에 채워진다 (v2 설계서 07 D2).
  registeredAt    DateTime? @map("registered_at") @db.Timestamptz(6)
  firstReservedAt DateTime? @map("first_reserved_at") @db.Timestamptz(6)
  contractedAt    DateTime? @map("contracted_at") @db.Timestamptz(6)
  notes           String?   @map("notes")
  /// 신체 정보 (v2 — 작업지시서 연동, 선택 입력)
  heightCm        Int?      @map("height_cm")
  weightKg        Decimal?  @map("weight_kg") @db.Decimal(5, 1)
  age             Int?      @map("age")
  rowVersion      Int       @default(0) @map("row_version")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointments          Appointment[]
  consultations         Consultation[]
  contracts             Contract[]
  measurementSessions   MeasurementSession[]
  repairRequests        RepairRequest[]
  notificationHistories NotificationHistory[]
  journeys              CustomerJourney[]

  @@index([name])
  @@index([registeredAt])
  @@map("customers")
}

model AppointmentPurpose {
  id        String   @id @db.Uuid
  code      String   @unique @map("code") @db.VarChar(40)
  name      String   @map("name") @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true) @map("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  appointments Appointment[]

  @@map("appointment_purposes")
}

/**
 * 코드 상수로 정의된 기준정보(품목·구성품·수선구분)의 표시명 오버라이드 (ADMIN-001).
 * 코드 집합·기본 표시명은 코드 상수(code-labels.constants)가 원본이며,
 * 이 테이블은 관리자가 바꾼 표시명만 저장한다(행 없으면 기본 표시명 사용).
 * 코드 추가·삭제는 불가하며 표시명만 편집 가능하다.
 */
model MasterCodeLabel {
  id        String   @id @db.Uuid
  domain    String   @map("domain") @db.VarChar(40)
  code      String   @map("code") @db.VarChar(40)
  label     String   @map("label") @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([domain, code])
  @@map("master_code_labels")
}

model Appointment {
  id             String    @id @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  source         String    @map("source") @db.VarChar(20)
  externalId     String?   @map("external_id") @db.VarChar(100)
  purposeId      String    @map("purpose_id") @db.Uuid
  scheduledStart DateTime  @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd   DateTime? @map("scheduled_end") @db.Timestamptz(6)
  status         String    @default("RESERVED") @map("status") @db.VarChar(20)
  notes          String?   @map("notes")
  naverUpdatedAt DateTime? @map("naver_updated_at") @db.Timestamptz(6)
  syncedAt       DateTime? @map("synced_at") @db.Timestamptz(6)
  localOverride  Boolean   @default(false) @map("local_override")
  rowVersion     Int       @default(0) @map("row_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer        Customer           @relation(fields: [customerId], references: [id])
  purpose         AppointmentPurpose @relation(fields: [purposeId], references: [id])
  consultations   Consultation[]
  fittingSessions FittingSession[]

  @@unique([source, externalId])
  @@index([scheduledStart, status])
  @@index([customerId])
  @@map("appointments")
}

model Consultation {
  id                   String    @id @db.Uuid
  customerId           String    @map("customer_id") @db.Uuid
  appointmentId        String?   @map("appointment_id") @db.Uuid
  consultedAt          DateTime  @map("consulted_at") @db.Timestamptz(6)
  consultationCategory String?   @map("consultation_category") @db.VarChar(30)
  content              String    @map("content")
  /**
   * 용도 (BUSINESS_CUSTOM | WEDDING_RENTAL) — 진행 단계 trackType과 1:1 대응
   */
  usageType            String?   @map("usage_type") @db.VarChar(30)
  /**
   * 예산 범위 (정수 원). 단일값이면 min=max
   */
  budgetMin            Int?      @map("budget_min")
  budgetMax            Int?      @map("budget_max")
  preferredStyle       String?   @map("preferred_style") @db.VarChar(200)
  /**
   * 고객이 희망한 납기 — 계약 시 orders.completion_due_date 기본값으로 제안
   */
  desiredDueDate       DateTime? @map("desired_due_date") @db.Date
  staffId              String    @map("staff_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer    Customer     @relation(fields: [customerId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  staff       User         @relation("ConsultationStaff", fields: [staffId], references: [id])

  @@index([customerId, consultedAt(sort: Desc)])
  @@map("consultations")
}

// -----------------------------------------------------------------------------
// 2. 계약 구분·계약 버전
// -----------------------------------------------------------------------------

model ContractType {
  id          String   @id @db.Uuid
  code        String   @unique @map("code") @db.VarChar(40)
  name        String   @map("name") @db.VarChar(100)
  description String?  @map("description")
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true) @map("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines     ContractTypeLine[]
  contracts Contract[]

  @@map("contract_types")
}

model ContractTypeLine {
  id              String   @id @db.Uuid
  contractTypeId  String   @map("contract_type_id") @db.Uuid
  transactionType String   @map("transaction_type") @db.VarChar(20)
  productCategory String   @map("product_category") @db.VarChar(20)
  defaultQuantity Int      @default(1) @map("default_quantity")
  sortOrder       Int      @default(0) @map("sort_order")
  active          Boolean  @default(true) @map("active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contractType ContractType @relation(fields: [contractTypeId], references: [id])

  @@map("contract_type_lines")
}

model Contract {
  id               String    @id @db.Uuid
  contractNo       String    @unique @map("contract_no") @db.VarChar(40)
  customerId       String    @map("customer_id") @db.Uuid
  contractTypeId   String?   @map("contract_type_id") @db.Uuid
  status           String    @default("DRAFT") @map("status") @db.VarChar(20)
  currentVersionId String?   @map("current_version_id") @db.Uuid
  contractedAt     DateTime? @map("contracted_at") @db.Timestamptz(6)
  rowVersion       Int       @default(0) @map("row_version")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer       Customer          @relation(fields: [customerId], references: [id])
  contractType   ContractType?     @relation(fields: [contractTypeId], references: [id])
  currentVersion ContractVersion?  @relation("ContractCurrentVersion", fields: [currentVersionId], references: [id])
  versions       ContractVersion[] @relation("ContractVersions")
  items          ContractItem[]
  orders         Order[]

  @@index([customerId, contractedAt(sort: Desc)])
  @@map("contracts")
}

model ContractVersion {
  id                String    @id @db.Uuid
  contractId        String    @map("contract_id") @db.Uuid
  versionNo         Int       @map("version_no")
  versionStatus     String    @default("DRAFT") @map("version_status") @db.VarChar(20)
  changeReason      String?   @map("change_reason")
  /// 총 계약금액. 거래가 전부 일시불이라 계약금·잔금은 두지 않는다(v2 확정 2026-07-28).
  totalAmount       Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  completionDueDate DateTime? @map("completion_due_date") @db.Date
  photoDate         DateTime? @map("photo_date") @db.Date
  weddingDate       DateTime? @map("wedding_date") @db.Date
  confirmedBy       String?   @map("confirmed_by") @db.Uuid
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // --- v2 D4 전자서명 (설계서 03 §2.2). nullable·신규라 기존 데이터 무손상. ---
  signatureFileId String?   @map("signature_file_id") @db.Uuid
  /// 계약 완료 시점에 구워 보관하는 계약서 엑셀 (설계서 03 M3 확정 2026-07-28).
  /// 완료 전에는 null이며 다운로드는 즉석 생성한다.
  excelFileId     String?   @map("excel_file_id") @db.Uuid
  signedAt        DateTime? @map("signed_at") @db.Timestamptz(6)
  signerName      String?   @map("signer_name") @db.VarChar(80)

  contract           Contract       @relation("ContractVersions", fields: [contractId], references: [id])
  confirmedByUser    User?          @relation("ContractVersionConfirmedBy", fields: [confirmedBy], references: [id])
  createdByUser      User           @relation("ContractVersionCreatedBy", fields: [createdBy], references: [id])
  currentOfContracts Contract[]     @relation("ContractCurrentVersion")
  signatureFile      File?          @relation("ContractVersionSignature", fields: [signatureFileId], references: [id])
  excelFile          File?          @relation("ContractVersionExcel", fields: [excelFileId], references: [id])
  lines              ContractLine[]

  @@unique([contractId, versionNo])
  @@map("contract_versions")
}

model ContractLine {
  id                String   @id @db.Uuid
  contractVersionId String   @map("contract_version_id") @db.Uuid
  transactionType   String   @map("transaction_type") @db.VarChar(20)
  productCategory   String   @map("product_category") @db.VarChar(20)
  itemDescription   String?  @map("item_description") @db.VarChar(150)
  quantity          Int      @map("quantity")
  unitPrice         Decimal? @map("unit_price") @db.Decimal(14, 2)
  lineAmount        Decimal  @default(0) @map("line_amount") @db.Decimal(14, 2)
  /// 맞춤 정장 라인의 베스트(3피스) 포함 여부 (현업 확정 2026-07-30).
  /// 계약서 품목표의 [베스트 제외] 체크박스가 이 값이다(체크 = false).
  /// 맞춤 정장의 기본은 3피스라 컬럼 기본값도 true다 (현업 확정 2026-07-31).
  /// 렌탈·셔츠·구두 라인은 베스트를 가질 수 없어 서비스가 false로 저장한다.
  vestIncluded      Boolean  @default(true) @map("vest_included")
  /// 베스트 포함 시 벌당 베스트 단가(수기). 금액 = 수량 × (단가 + 베스트 단가).
  /// 컨설팅 중 베스트를 제외하면 이 값만큼 라인·계약 금액에서 자동 차감한다.
  vestUnitPrice     Decimal? @map("vest_unit_price") @db.Decimal(14, 2)
  notes             String?  @map("notes")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contractVersion ContractVersion @relation(fields: [contractVersionId], references: [id])
  contractItems   ContractItem[]

  @@index([contractVersionId, transactionType, productCategory])
  @@map("contract_lines")
}

// -----------------------------------------------------------------------------
// 1-b. 계약 품목·부위 — 컨설팅(옵션·렌탈 선택)의 앵커.
//   흐름: 계약(작성중) → 컨설팅 → 서명 → 계약완료 → 주문.
//   주문(Order/OrderItem)은 계약완료 후에만 생기고, 컨설팅은 이 계약 품목에 붙는다.
//   계약 라인(카테고리×수량)을 벌 단위(정장 #1, #2)로 펼친 것이며 부위(상의/하의)를 갖는다.
//
//   **품목은 버전이 아니라 계약에 매달린다** (현업 확정 2026-07-30). 수정하기(버전업)는
//   계약서 문서의 버전업이므로, 품목과 그에 딸린 컨설팅·주문·작업지시서·입출고는 그대로
//   이어져야 한다. 버전별 수량·금액 이력은 ContractLine 이 갖는다.
// -----------------------------------------------------------------------------

model ContractItem {
  id                   String    @id @db.Uuid
  contractId           String    @map("contract_id") @db.Uuid
  // 계약 수정 시 계약 라인은 삭제·재생성되고 버전업 때는 새 버전 라인이 생긴다 → 라인 참조는 nullable·SetNull.
  sourceContractLineId String?   @map("source_contract_line_id") @db.Uuid
  transactionType      String    @map("transaction_type") @db.VarChar(20)
  productCategory      String    @map("product_category") @db.VarChar(20)
  sequenceNo           Int       @map("sequence_no")
  displayName          String    @map("display_name") @db.VarChar(100)
  status               String    @default("CREATED") @map("status") @db.VarChar(30)
  cancelledReason      String?   @map("cancelled_reason")
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz(6)
  rowVersion           Int       @default(0) @map("row_version")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  contract                Contract                 @relation(fields: [contractId], references: [id])
  sourceContractLine      ContractLine?            @relation(fields: [sourceContractLineId], references: [id], onDelete: SetNull)
  components              ContractItemComponent[]
  optionSelectionSessions OptionSelectionSession[]
  rentalSelectionSessions RentalSelectionSession[]
  orderItems              OrderItem[]

  @@unique([contractId, transactionType, productCategory, sequenceNo])
  @@index([contractId])
  @@map("contract_items")
}

model ContractItemComponent {
  id             String   @id @db.Uuid
  contractItemId String   @map("contract_item_id") @db.Uuid
  componentType  String   @map("component_type") @db.VarChar(20)
  sequenceNo     Int      @default(1) @map("sequence_no")
  status         String   @default("CREATED") @map("status") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contractItem         ContractItem          @relation(fields: [contractItemId], references: [id])
  rentalSelectionLines RentalSelectionLine[]

  @@index([contractItemId, componentType])
  @@map("contract_item_components")
}

// -----------------------------------------------------------------------------
// 2. 주문·품목·구성품
// -----------------------------------------------------------------------------

model Order {
  id                String    @id @db.Uuid
  orderNo           String    @unique @map("order_no") @db.VarChar(40)
  contractId        String    @map("contract_id") @db.Uuid
  transactionType   String    @map("transaction_type") @db.VarChar(20)
  status            String    @default("CREATED") @map("status") @db.VarChar(30)
  completionDueDate DateTime? @map("completion_due_date") @db.Date
  photoDate         DateTime? @map("photo_date") @db.Date
  weddingDate       DateTime? @map("wedding_date") @db.Date
  rowVersion        Int       @default(0) @map("row_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  contract              Contract              @relation(fields: [contractId], references: [id])
  items                 OrderItem[]
  measurementSessions   MeasurementSession[]
  repairRequests        RepairRequest[]
  notificationHistories NotificationHistory[]
  journeys              CustomerJourney[]

  @@unique([contractId, transactionType])
  @@map("orders")
}

model OrderItem {
  id                   String    @id @db.Uuid
  orderId              String    @map("order_id") @db.Uuid
  sourceContractItemId String    @map("source_contract_item_id") @db.Uuid
  productCategory      String    @map("product_category") @db.VarChar(20)
  sequenceNo           Int       @map("sequence_no")
  displayName          String    @map("display_name") @db.VarChar(100)
  status               String    @default("CREATED") @map("status") @db.VarChar(30)
  cancelledReason      String?   @map("cancelled_reason")
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz(6)
  rowVersion           Int       @default(0) @map("row_version")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order              Order                  @relation(fields: [orderId], references: [id])
  sourceContractItem ContractItem           @relation(fields: [sourceContractItemId], references: [id])
  components         OrderItemComponent[]
  measurementLinks   OrderItemMeasurement[]
  workOrder          WorkOrder?
  productionEvents   ProductionEvent[]
  fittingSessions    FittingSession[]
  repairRequests     RepairRequest[]

  @@unique([orderId, productCategory, sequenceNo])
  @@map("order_items")
}

model OrderItemComponent {
  id                  String    @id @db.Uuid
  orderItemId         String    @map("order_item_id") @db.Uuid
  componentType       String    @map("component_type") @db.VarChar(20)
  sequenceNo          Int       @default(1) @map("sequence_no")
  status              String    @default("CREATED") @map("status") @db.VarChar(30)
  expectedInboundDate DateTime? @map("expected_inbound_date") @db.Date
  actualInboundAt     DateTime? @map("actual_inbound_at") @db.Timestamptz(6)
  actualOutboundAt    DateTime? @map("actual_outbound_at") @db.Timestamptz(6)
  notes               String?   @map("notes")
  active              Boolean   @default(true) @map("active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItem          OrderItem           @relation(fields: [orderItemId], references: [id])
  productionEvents   ProductionEvent[]
  fittingAdjustments FittingAdjustment[]
  rentalAllocations  RentalAllocation[]
  repairRequests     RepairRequest[]

  @@index([orderItemId, componentType])
  @@map("order_item_components")
}

// -----------------------------------------------------------------------------
// 3. 옵션 세트·임시저장·확정
// -----------------------------------------------------------------------------

model OptionSet {
  id              String   @id @db.Uuid
  productCategory String   @unique @map("product_category") @db.VarChar(20)
  name            String   @map("name") @db.VarChar(100)
  activeVersionId String?  @map("active_version_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  activeVersion OptionSetVersion?  @relation("OptionSetActiveVersion", fields: [activeVersionId], references: [id])
  versions      OptionSetVersion[] @relation("OptionSetVersions")

  @@map("option_sets")
}

model OptionSetVersion {
  id            String    @id @db.Uuid
  optionSetId   String    @map("option_set_id") @db.Uuid
  versionNo     Int       @map("version_no")
  status        String    @default("DRAFT") @map("status") @db.VarChar(20)
  effectiveFrom DateTime? @map("effective_from") @db.Date
  description   String?   @map("description")
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  optionSet          OptionSet                @relation("OptionSetVersions", fields: [optionSetId], references: [id])
  createdByUser      User                     @relation("OptionSetVersionCreatedBy", fields: [createdBy], references: [id])
  activeOfOptionSets OptionSet[]              @relation("OptionSetActiveVersion")
  stages             OptionStage[]
  selectionSessions  OptionSelectionSession[]

  @@unique([optionSetId, versionNo])
  @@map("option_set_versions")
}

model OptionStage {
  id                 String   @id @db.Uuid
  optionSetVersionId String   @map("option_set_version_id") @db.Uuid
  stageCode          String   @map("stage_code") @db.VarChar(40)
  stageName          String   @map("stage_name") @db.VarChar(100)
  sequenceNo         Int      @map("sequence_no")
  required           Boolean  @default(true) @map("required")
  /// JACKET/TROUSERS/VEST 등 부위 그룹 (D5). 셔츠·구두 등 단일 부위 세트는 null 허용.
  componentGroup     String?  @map("component_group") @db.VarChar(20)
  active             Boolean  @default(true) @map("active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  optionSetVersion OptionSetVersion         @relation(fields: [optionSetVersionId], references: [id])
  choices          OptionChoice[]
  selectionValues  OptionSelectionValue[]
  currentSessions  OptionSelectionSession[] @relation("OptionSelectionSessionCurrentStage")

  @@unique([optionSetVersionId, stageCode])
  @@unique([optionSetVersionId, sequenceNo])
  @@map("option_stages")
}

model OptionChoice {
  id            String   @id @db.Uuid
  optionStageId String   @map("option_stage_id") @db.Uuid
  /**
   * A~Z 다음은 AA~AN. 구두처럼 한 단계에 스타일을 26개 넘게 펼치는 품목이 있다.
   */
  choiceCode    String   @map("choice_code") @db.VarChar(2)
  choiceName    String   @map("choice_name") @db.VarChar(100)
  factoryLabel  String?  @map("factory_label") @db.VarChar(100)
  imageFileId   String   @map("image_file_id") @db.Uuid
  /**
   * 이 선택지를 고를 때 계약금액에 더해지는 추가금액(원). 기본 선택지는 0.
   */
  extraPrice    Decimal  @default(0) @map("extra_price") @db.Decimal(12, 2)
  active        Boolean  @default(true) @map("active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  optionStage     OptionStage            @relation(fields: [optionStageId], references: [id])
  imageFile       File                   @relation(fields: [imageFileId], references: [id])
  selectionValues OptionSelectionValue[]

  @@unique([optionStageId, choiceCode])
  @@map("option_choices")
}

model OptionSelectionSession {
  id                 String    @id @db.Uuid
  contractItemId     String    @map("contract_item_id") @db.Uuid
  optionSetVersionId String    @map("option_set_version_id") @db.Uuid
  selectionVersionNo Int       @map("selection_version_no")
  status             String    @default("NOT_STARTED") @map("status") @db.VarChar(20)
  currentStageId     String?   @map("current_stage_id") @db.Uuid
  fabricName         String?   @map("fabric_name") @db.VarChar(150)
  startedAt          DateTime? @map("started_at") @db.Timestamptz(6)
  lastSavedAt        DateTime? @map("last_saved_at") @db.Timestamptz(6)
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz(6)
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /**
   * 이 세션의 옵션 추가금액 중 계약금액에 이미 반영한 누계.
   * 재확정 시 (현재 합계 - 이 값)만 차액으로 더한다. 계약 버전은 올리지 않는다.
   */
  surchargeApplied   Decimal   @default(0) @map("surcharge_applied") @db.Decimal(12, 2)
  surchargeAppliedAt DateTime? @map("surcharge_applied_at") @db.Timestamptz(6)
  isCurrent          Boolean   @default(true) @map("is_current")
  rowVersion         Int       @default(0) @map("row_version")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  contractItem      ContractItem                   @relation(fields: [contractItemId], references: [id])
  optionSetVersion  OptionSetVersion               @relation(fields: [optionSetVersionId], references: [id])
  currentStage      OptionStage?                   @relation("OptionSelectionSessionCurrentStage", fields: [currentStageId], references: [id])
  values            OptionSelectionValue[]
  workOrderVersions WorkOrderVersion[]
  componentAttrs    OptionSelectionComponentAttr[]

  @@unique([contractItemId, selectionVersionNo])
  @@index([contractItemId, isCurrent, status])
  @@map("option_selection_sessions")
}

/// 맞춤 옵션 세션의 부위(구성품 그룹)별 원단·컬러·패턴 수기입력 (v2 D3/설계서 04 §2).
/// (세션, componentGroup)당 1행. 셔츠/구두는 componentGroup 단일 행.
model OptionSelectionComponentAttr {
  id                 String   @id @db.Uuid
  selectionSessionId String   @map("selection_session_id") @db.Uuid
  /// JACKET/TROUSERS/VEST/SHIRT/SHOES — component-type 코드 재사용
  componentGroup     String   @map("component_group") @db.VarChar(20)
  fabricName         String?  @map("fabric_name") @db.VarChar(150)
  colorName          String?  @map("color_name") @db.VarChar(150)
  patternName        String?  @map("pattern_name") @db.VarChar(150)
  notes              String?  @map("notes")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  selectionSession OptionSelectionSession @relation(fields: [selectionSessionId], references: [id])

  @@unique([selectionSessionId, componentGroup])
  @@map("option_selection_component_attrs")
}

model OptionSelectionValue {
  id                 String   @id @db.Uuid
  selectionSessionId String   @map("selection_session_id") @db.Uuid
  optionStageId      String   @map("option_stage_id") @db.Uuid
  optionChoiceId     String   @map("option_choice_id") @db.Uuid
  /**
   * 선택 시점의 option_choices.extra_price 복사본.
   * 마스터 단가가 뒤에 바뀌어도 이미 선택된 건의 금액은 흔들리지 않는다.
   */
  extraPriceSnapshot Decimal  @default(0) @map("extra_price_snapshot") @db.Decimal(12, 2)
  selectedBy         String   @map("selected_by") @db.Uuid
  selectedAt         DateTime @default(now()) @map("selected_at") @db.Timestamptz(6)

  selectionSession OptionSelectionSession @relation(fields: [selectionSessionId], references: [id])
  optionStage      OptionStage            @relation(fields: [optionStageId], references: [id])
  optionChoice     OptionChoice           @relation(fields: [optionChoiceId], references: [id])
  selectedByUser   User                   @relation("OptionSelectionValueSelectedBy", fields: [selectedBy], references: [id])

  @@unique([selectionSessionId, optionStageId])
  @@map("option_selection_values")
}

// -----------------------------------------------------------------------------
// 3. 채촌·버전 비교
// -----------------------------------------------------------------------------

model MeasurementSession {
  id                String    @id @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  relatedOrderId    String?   @map("related_order_id") @db.Uuid
  versionNo         Int       @map("version_no")
  measurementDate   DateTime  @map("measurement_date") @db.Date
  measurementType   String    @default("INITIAL") @map("measurement_type") @db.VarChar(20)
  previousSessionId String?   @map("previous_session_id") @db.Uuid
  fitPreference     String?   @map("fit_preference") @db.VarChar(100)
  bodyNotes         String?   @map("body_notes")
  notes             String?   @map("notes")
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  customer          Customer               @relation(fields: [customerId], references: [id])
  relatedOrder      Order?                 @relation(fields: [relatedOrderId], references: [id])
  previousSession   MeasurementSession?    @relation("MeasurementSessionPrevious", fields: [previousSessionId], references: [id])
  nextSessions      MeasurementSession[]   @relation("MeasurementSessionPrevious")
  createdByUser     User                   @relation("MeasurementSessionCreatedBy", fields: [createdBy], references: [id])
  values            MeasurementValue[]
  orderItemLinks    OrderItemMeasurement[]
  workOrderVersions WorkOrderVersion[]

  @@unique([customerId, versionNo])
  @@index([customerId, measurementDate(sort: Desc)])
  @@map("measurement_sessions")
}

model MeasurementValue {
  id                   String   @id @db.Uuid
  measurementSessionId String   @map("measurement_session_id") @db.Uuid
  bodySection          String   @map("body_section") @db.VarChar(20)
  measurementCode      String   @map("measurement_code") @db.VarChar(40)
  numericValue         Decimal? @map("numeric_value") @db.Decimal(8, 2)
  textValue            String?  @map("text_value") @db.VarChar(40)
  unit                 String   @default("CM") @map("unit") @db.VarChar(10)
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  measurementSession MeasurementSession @relation(fields: [measurementSessionId], references: [id])

  @@unique([measurementSessionId, measurementCode])
  @@index([bodySection])
  @@map("measurement_values")
}

model OrderItemMeasurement {
  id                   String   @id @db.Uuid
  orderItemId          String   @map("order_item_id") @db.Uuid
  measurementSessionId String   @map("measurement_session_id") @db.Uuid
  isCurrent            Boolean  @default(true) @map("is_current")
  linkedBy             String   @map("linked_by") @db.Uuid
  linkedAt             DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)

  orderItem          OrderItem          @relation(fields: [orderItemId], references: [id])
  measurementSession MeasurementSession @relation(fields: [measurementSessionId], references: [id])
  linkedByUser       User               @relation("OrderItemMeasurementLinkedBy", fields: [linkedBy], references: [id])

  @@index([orderItemId, isCurrent])
  @@map("order_item_measurements")
}

// -----------------------------------------------------------------------------
// 4. 작업지시서·제작·입출고
// -----------------------------------------------------------------------------

model WorkOrder {
  id               String   @id @db.Uuid
  orderItemId      String   @unique @map("order_item_id") @db.Uuid
  currentVersionId String?  @map("current_version_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem      OrderItem          @relation(fields: [orderItemId], references: [id])
  currentVersion WorkOrderVersion?  @relation("WorkOrderCurrentVersion", fields: [currentVersionId], references: [id])
  versions       WorkOrderVersion[] @relation("WorkOrderVersions")

  @@map("work_orders")
}

model WorkOrderVersion {
  id                         String    @id @db.Uuid
  workOrderId                String    @map("work_order_id") @db.Uuid
  versionNo                  Int       @map("version_no")
  sourceOptionSessionId      String    @map("source_option_session_id") @db.Uuid
  sourceMeasurementSessionId String    @map("source_measurement_session_id") @db.Uuid
  optionSnapshot             Json      @map("option_snapshot")
  measurementSnapshot        Json      @map("measurement_snapshot")
  sourceHash                 String    @map("source_hash") @db.VarChar(64)
  changeReason               String?   @map("change_reason")
  outputFileId               String    @map("output_file_id") @db.Uuid
  status                     String    @default("ISSUED") @map("status") @db.VarChar(20)
  issuedBy                   String    @map("issued_by") @db.Uuid
  issuedAt                   DateTime  @map("issued_at") @db.Timestamptz(6)
  sentAt                     DateTime? @map("sent_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workOrder                WorkOrder              @relation("WorkOrderVersions", fields: [workOrderId], references: [id])
  sourceOptionSession      OptionSelectionSession @relation(fields: [sourceOptionSessionId], references: [id])
  sourceMeasurementSession MeasurementSession     @relation(fields: [sourceMeasurementSessionId], references: [id])
  outputFile               File                   @relation(fields: [outputFileId], references: [id])
  issuedByUser             User                   @relation("WorkOrderVersionIssuedBy", fields: [issuedBy], references: [id])
  currentOfWorkOrders      WorkOrder[]            @relation("WorkOrderCurrentVersion")

  @@unique([workOrderId, versionNo])
  @@index([workOrderId, issuedAt(sort: Desc)])
  @@index([sourceHash])
  @@map("work_order_versions")
}

model ProductionEvent {
  id             String    @id @db.Uuid
  orderItemId    String    @map("order_item_id") @db.Uuid
  componentId    String?   @map("component_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(40)
  previousStatus String?   @map("previous_status") @db.VarChar(30)
  newStatus      String    @map("new_status") @db.VarChar(30)
  expectedDate   DateTime? @map("expected_date") @db.Date
  eventDate      DateTime  @map("event_date") @db.Date
  notes          String?   @map("notes")
  actorId        String    @map("actor_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem OrderItem           @relation(fields: [orderItemId], references: [id])
  component OrderItemComponent? @relation(fields: [componentId], references: [id])
  actor     User                @relation("ProductionEventActor", fields: [actorId], references: [id])

  @@index([orderItemId, eventDate])
  @@index([eventType])
  @@index([expectedDate, newStatus])
  @@map("production_events")
}

model FittingSession {
  id                  String    @id @db.Uuid
  orderItemId         String    @map("order_item_id") @db.Uuid
  appointmentId       String?   @map("appointment_id") @db.Uuid
  fittingDate         DateTime  @map("fitting_date") @db.Date
  notes               String?   @map("notes")
  nextAppointmentDate DateTime? @map("next_appointment_date") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItem   OrderItem           @relation(fields: [orderItemId], references: [id])
  appointment Appointment?        @relation(fields: [appointmentId], references: [id])
  adjustments FittingAdjustment[]

  @@index([fittingDate])
  @@map("fitting_sessions")
}

model FittingAdjustment {
  id               String   @id @db.Uuid
  fittingSessionId String   @map("fitting_session_id") @db.Uuid
  componentId      String?  @map("component_id") @db.Uuid
  /**
   * 표준 확인 항목 (SILHOUETTE | BALANCE | EASE | LENGTH | ETC) — 설계서 1페이지 가봉 단계
   */
  areaCode         String   @default("ETC") @map("area_code") @db.VarChar(20)
  /**
   * 세부 부위 자유입력 (예: 왼쪽 소매)
   */
  area             String   @map("area") @db.VarChar(80)
  instruction      String   @map("instruction")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fittingSession FittingSession      @relation(fields: [fittingSessionId], references: [id])
  component      OrderItemComponent? @relation(fields: [componentId], references: [id])

  @@map("fitting_adjustments")
}

// -----------------------------------------------------------------------------
// 5. 렌탈 실물·기간 배정
// -----------------------------------------------------------------------------

/// 렌탈 SKU. 디자인 축은 폐기했다 — 실물은 구분 + 컬러 + 사이즈로만 식별한다.
model RentalSku {
  id            String   @id @db.Uuid
  componentType String   @map("component_type") @db.VarChar(20)
  color         String   @map("color") @db.VarChar(80)
  size          String   @map("size") @db.VarChar(40)
  description   String?  @map("description")
  active        Boolean  @default(true) @map("active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventoryItems RentalInventoryItem[]

  @@unique([componentType, color, size])
  @@map("rental_skus")
}

/// 실물 한 벌. managementCode는 전역 UNIQUE가 아니라 "폐기되지 않은 것들 사이에서만" 유일하다
/// (마이그레이션의 부분 UNIQUE 인덱스). 폐기한 옷의 코드표를 새 옷에 다시 붙여 쓰기 때문이다.
model RentalInventoryItem {
  id             String    @id @db.Uuid
  managementCode String    @map("management_code") @db.VarChar(60)
  rentalSkuId    String    @map("rental_sku_id") @db.Uuid
  status         String    @default("AVAILABLE") @map("status") @db.VarChar(25)
  availableFrom  DateTime? @map("available_from") @db.Date
  notes          String?   @map("notes")
  active         Boolean   @default(true) @map("active")
  acquiredAt     DateTime? @map("acquired_at") @db.Date
  retiredAt      DateTime? @map("retired_at") @db.Date
  rowVersion     Int       @default(0) @map("row_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  rentalSku            RentalSku                    @relation(fields: [rentalSkuId], references: [id])
  statusEvents         RentalInventoryStatusEvent[]
  allocations          RentalAllocation[]
  oldAllocationEvents  RentalAllocationEvent[]      @relation("RentalAllocationEventOldItem")
  newAllocationEvents  RentalAllocationEvent[]      @relation("RentalAllocationEventNewItem")
  rentalSelectionLines RentalSelectionLine[]

  @@index([status, availableFrom])
  @@index([managementCode])
  @@map("rental_inventory_items")
}

model RentalAllocation {
  id                    String    @id @db.Uuid
  orderItemComponentId  String    @map("order_item_component_id") @db.Uuid
  rentalInventoryItemId String    @map("rental_inventory_item_id") @db.Uuid
  pickupDate            DateTime  @map("pickup_date") @db.Date
  returnDueDate         DateTime  @map("return_due_date") @db.Date
  availabilityEndDate   DateTime  @map("availability_end_date") @db.Date
  actualPickupAt        DateTime? @map("actual_pickup_at") @db.Timestamptz(6)
  actualReturnAt        DateTime? @map("actual_return_at") @db.Timestamptz(6)
  status                String    @default("RESERVED") @map("status") @db.VarChar(25)
  assignedBy            String    @map("assigned_by") @db.Uuid
  assignedAt            DateTime  @map("assigned_at") @db.Timestamptz(6)
  rowVersion            Int       @default(0) @map("row_version")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItemComponent  OrderItemComponent      @relation(fields: [orderItemComponentId], references: [id])
  rentalInventoryItem RentalInventoryItem     @relation(fields: [rentalInventoryItemId], references: [id])
  assignedByUser      User                    @relation("RentalAllocationAssignedBy", fields: [assignedBy], references: [id])
  events              RentalAllocationEvent[]
  notes               RentalAllocationNote[]

  @@index([rentalInventoryItemId, pickupDate, availabilityEndDate])
  @@index([returnDueDate, status])
  @@map("rental_allocations")
}

/// 배정 한 건에 붙는 비고 — 연락·회신·변경·메모가 한 줄에 시간순으로 쌓인다.
///
/// 발송 이력(notification_history)은 고객·주문까지만 엮여 있어 "이 대여 건에 몇 번 연락했나"를
/// 셀 수 없고, 보낸 사람도 감사로그에만 남아 목록에서 쓸 수 없었다. 전화로 받은 답을 적을 곳도
/// 없었다. 반납일이 밀리는 사정도 배정 기간을 고치지 않고 여기에만 남긴다 —
/// 원래 기간으로 걸어 둔 기간 잠금을 흔들지 않으려는 것이다(현업 확정 2026-08-03).
model RentalAllocationNote {
  id                    String   @id @db.Uuid
  rentalAllocationId    String   @map("rental_allocation_id") @db.Uuid
  /// CONTACT(연락 발송) · REPLY(고객 회신) · CHANGE(반납일 등 변경) · MEMO
  kind                  String   @map("kind") @db.VarChar(20)
  body                  String   @map("body")
  /// 쓴 사람 = 보낸 사람
  actorId               String   @map("actor_id") @db.Uuid
  /// CONTACT일 때 실제 발송 이력
  notificationHistoryId String?  @map("notification_history_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rentalAllocation    RentalAllocation     @relation(fields: [rentalAllocationId], references: [id])
  actor               User                 @relation("RentalAllocationNoteActor", fields: [actorId], references: [id])
  notificationHistory NotificationHistory? @relation(fields: [notificationHistoryId], references: [id])

  @@index([rentalAllocationId, createdAt(sort: Desc)])
  @@map("rental_allocation_notes")
}

model RentalAllocationEvent {
  id                 String   @id @db.Uuid
  rentalAllocationId String   @map("rental_allocation_id") @db.Uuid
  eventType          String   @map("event_type") @db.VarChar(30)
  oldInventoryItemId String?  @map("old_inventory_item_id") @db.Uuid
  newInventoryItemId String?  @map("new_inventory_item_id") @db.Uuid
  reason             String?  @map("reason")
  actorId            String   @map("actor_id") @db.Uuid
  occurredAt         DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  rentalAllocation RentalAllocation     @relation(fields: [rentalAllocationId], references: [id])
  oldInventoryItem RentalInventoryItem? @relation("RentalAllocationEventOldItem", fields: [oldInventoryItemId], references: [id])
  newInventoryItem RentalInventoryItem? @relation("RentalAllocationEventNewItem", fields: [newInventoryItemId], references: [id])
  actor            User                 @relation("RentalAllocationEventActor", fields: [actorId], references: [id])

  @@index([rentalAllocationId, eventType])
  @@map("rental_allocation_events")
}

model RentalInventoryStatusEvent {
  id                    String    @id @db.Uuid
  rentalInventoryItemId String    @map("rental_inventory_item_id") @db.Uuid
  previousStatus        String?   @map("previous_status") @db.VarChar(25)
  newStatus             String    @map("new_status") @db.VarChar(25)
  availableFrom         DateTime? @map("available_from") @db.Date
  reason                String?   @map("reason")
  actorId               String    @map("actor_id") @db.Uuid
  occurredAt            DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  rentalInventoryItem RentalInventoryItem @relation(fields: [rentalInventoryItemId], references: [id])
  actor               User                @relation("RentalInventoryStatusEventActor", fields: [actorId], references: [id])

  @@index([rentalInventoryItemId, occurredAt(sort: Desc)])
  @@map("rental_inventory_status_events")
}

// -----------------------------------------------------------------------------
// 5-b. 렌탈 기준정보(컬러·사이즈) · 스타일 선택 (v2 D3 / 설계서 04 §4·§5)
// -----------------------------------------------------------------------------

/// 렌탈 컬러 기준정보 (ADMIN-001, type=rental-colors). 12색 다운리스트 코드 소스.
/// 렌탈 컬러. componentTypes = 이 색이 존재하는 품목 목록(예: 3피스는 상의·하의·베스트).
/// 비어 있으면 전 품목 공통으로 본다.
model RentalColor {
  id             String   @id @db.Uuid
  code           String   @unique @map("code") @db.VarChar(30)
  name           String   @map("name") @db.VarChar(100)
  /// 반납 후 정비(세탁) 소요일을 가르는 색 계열. LIGHT=화이트·베이지 계열, DARK=그 외.
  /// 소요일 자체는 rental_return_policies에 있다 — 여기서는 어느 쪽인지만 정한다.
  tone           String   @default("DARK") @map("tone") @db.VarChar(10)
  componentTypes String[] @map("component_types")
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true) @map("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("rental_colors")
}

/// 렌탈 반납 후 정비 기준 (ADMIN-001 "렌탈 정비 기준"). 항상 한 행만 둔다 —
/// 매장이 하나뿐이라 기준도 하나다. id는 SINGLETON_POLICY_ID 고정값.
model RentalReturnPolicy {
  id                String   @id @db.Uuid
  /// 밝은색(tone=LIGHT) 정비 소요일 — 세탁 확인이 필요해 기본 2일
  lightCleaningDays Int      @default(2) @map("light_cleaning_days")
  /// 블랙 타입(tone=DARK) 정비 소요일 — 기본 1일
  darkCleaningDays  Int      @default(1) @map("dark_cleaning_days")
  /// 정비일이 도래한 반납 대기 실물을 자동으로 대여 가능으로 올릴지
  autoRelease       Boolean  @default(true) @map("auto_release")
  updatedBy         String?  @map("updated_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("rental_return_policies")
}

/// 렌탈 사이즈 기준정보 (ADMIN-001, type=rental-sizes).
/// 렌탈 사이즈. 품목마다 체계가 다르다(상의·베스트 46~60, 하의 80~104, 셔츠 95~120, 구두 250~280).
/// componentTypes로 갈라 두지 않으면 상의 등록 화면에 구두 사이즈가 섞인다.
model RentalSize {
  id             String   @id @db.Uuid
  code           String   @unique @map("code") @db.VarChar(30)
  name           String   @map("name") @db.VarChar(100)
  componentTypes String[] @map("component_types")
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true) @map("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("rental_sizes")
}

/// 렌탈 스타일 선택 세션 — 렌탈 주문 품목(OrderItem)당 1개(현재본).
/// 맞춤 옵션 세션과 분리된 렌탈 전용 흐름. transactionType=RENTAL 품목에만.
model RentalSelectionSession {
  id                 String    @id @db.Uuid
  contractItemId     String    @map("contract_item_id") @db.Uuid
  selectionVersionNo Int       @default(1) @map("selection_version_no")
  status             String    @default("IN_PROGRESS") @map("status") @db.VarChar(20)
  /// 대여 기간 (현업 확정 2026-07-28: 대여 날짜는 필수값).
  /// 이 기간으로 가용 실물을 찾고 확정한다. 기존 행 보존을 위해 컬럼은 nullable이며
  /// 후보 검색·확정 시점에 앱이 필수로 검증한다.
  pickupDate         DateTime? @map("pickup_date") @db.Date
  returnDueDate      DateTime? @map("return_due_date") @db.Date
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(6)
  isCurrent          Boolean   @default(true) @map("is_current")
  rowVersion         Int       @default(0) @map("row_version")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  contractItem ContractItem          @relation(fields: [contractItemId], references: [id])
  lines        RentalSelectionLine[]

  @@unique([contractItemId, selectionVersionNo])
  @@index([contractItemId, isCurrent])
  @@map("rental_selection_sessions")
}

/// 부위(구성품)별 컬러·사이즈·비고 + 선택한 후보 실물.
model RentalSelectionLine {
  id                      String   @id @db.Uuid
  sessionId               String   @map("session_id") @db.Uuid
  /// 어느 구성품에 대한 선택인지 — 가계약 품목 부위(ContractItemComponent)와 연결.
  /// 확정 후 실물 배정은 OrderItemComponent에서 이 선택을 참조한다.
  contractItemComponentId String   @map("contract_item_component_id") @db.Uuid
  componentType           String   @map("component_type") @db.VarChar(20)
  /// 기준정보 rental_colors.code (12색)
  colorCode               String?  @map("color_code") @db.VarChar(30)
  /// 기준정보 rental_sizes.code
  sizeCode                String?  @map("size_code") @db.VarChar(30)
  /// 수선명령(수치 등) 수기 — 비고
  notes                   String?  @map("notes")
  /// 선택한 후보 실물(대여 기간 기준 가용검색 결과). 아직 고르기 전이면 null.
  selectedInventoryItemId String?  @map("selected_inventory_item_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  session               RentalSelectionSession @relation(fields: [sessionId], references: [id])
  contractItemComponent ContractItemComponent  @relation(fields: [contractItemComponentId], references: [id])
  selectedInventoryItem RentalInventoryItem?   @relation(fields: [selectedInventoryItemId], references: [id])

  @@unique([sessionId, contractItemComponentId])
  @@map("rental_selection_lines")
}

// -----------------------------------------------------------------------------
// 6. 수선·결제
// -----------------------------------------------------------------------------

model RepairRequest {
  id              String    @id @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  orderId         String?   @map("order_id") @db.Uuid
  orderItemId     String?   @map("order_item_id") @db.Uuid
  componentId     String?   @map("component_id") @db.Uuid
  repairType      String    @map("repair_type") @db.VarChar(30)
  requestDate     DateTime  @map("request_date") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date
  status          String    @default("RECEIVED") @map("status") @db.VarChar(25)
  description     String    @map("description")
  /**
   * 접수 방식 (VISIT 고객 방문 | PICKUP 방문 수거)
   */
  receiptMethod   String?   @map("receipt_method") @db.VarChar(20)
  /**
   * 출고 방식 (VISIT 고객 방문 | DELIVERY 방문 배송)
   */
  releaseMethod   String?   @map("release_method") @db.VarChar(20)
  pickupAddress   String?   @map("pickup_address") @db.VarChar(300)
  deliveryAddress String?   @map("delivery_address") @db.VarChar(300)
  notes           String?   @map("notes")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 렌탈 실물은 연결하지 않는다 — 렌탈 수선은 렌탈 진행(RENTAL 트랙)에서 관리한다.
  customer     Customer            @relation(fields: [customerId], references: [id])
  order        Order?              @relation(fields: [orderId], references: [id])
  orderItem    OrderItem?          @relation(fields: [orderItemId], references: [id])
  component    OrderItemComponent? @relation(fields: [componentId], references: [id])
  items        RepairRequestItem[]
  statusEvents RepairStatusEvent[]
  // 수선 접수 시 자동 생성되는 REPAIR 진행 트랙 (설계서 02 §7.2·§9.2). 접수 1건 = 진행 1건.
  journey      CustomerJourney?    @relation("RepairJourney")

  @@index([requestDate])
  @@index([dueDate, status])
  @@map("repair_requests")
}

/**
 * 수선 대상 품목·개수. 접수 1건에 여러 줄이 붙는다(상의 1, 하의 2 …).
 * 품목 코드는 기준정보 component-type(JACKET/TROUSERS/VEST/SHIRT/SHOES)이며,
 * 계약에 등록된 주문 품목과 무관하게 자유 선택한다.
 */
model RepairRequestItem {
  id              String    @id @db.Uuid
  repairRequestId String    @map("repair_request_id") @db.Uuid
  targetProduct   String    @map("target_product") @db.VarChar(30)
  quantity        Int       @default(1) @map("quantity")
  sequenceNo      Int       @map("sequence_no")
  /// 수선요청(수선집에 보냄)을 끝낸 시점. null이면 아직 요청 전 — 요청은 줄 단위로 한 번 누른다.
  requestedAt     DateTime? @map("requested_at") @db.Date

  repairRequest RepairRequest           @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  units         RepairRequestItemUnit[]
  statusEvents  RepairStatusEvent[]

  @@index([repairRequestId, sequenceNo])
  @@map("repair_request_items")
}

/**
 * 입고·출고를 세는 최소 단위. 접수 줄의 수량만큼 생성한다(상의 2 → #1·#2).
 * 같은 품목이라도 수선집에서 따로 나오고 고객이 따로 찾아가므로 개별로 센다.
 * 수선요청은 줄 단위라 여기 없다 — 상태는 대기(PENDING)→입고(RETURNED)→출고(RELEASED) 한 줄이다.
 */
model RepairRequestItemUnit {
  id                  String @id @db.Uuid
  repairRequestItemId String @map("repair_request_item_id") @db.Uuid
  /// 줄 안에서의 번호 (1..quantity) — 화면 표시가 흔들리지 않게 굳혀 둔다.
  unitNo              Int    @map("unit_no")
  status              String @default("PENDING") @map("status") @db.VarChar(20)

  item         RepairRequestItem   @relation(fields: [repairRequestItemId], references: [id], onDelete: Cascade)
  statusEvents RepairStatusEvent[]

  @@unique([repairRequestItemId, unitNo])
  @@map("repair_request_item_units")
}

/**
 * 수선 진행 이력. 건 단위 전이(접수·고객 연락·롤업 결과)는 item/unit이 모두 null이고,
 * 줄 단위(수선요청)는 itemId, 유닛 단위(입고·출고)는 unitId가 채워진다.
 */
model RepairStatusEvent {
  id                      String   @id @db.Uuid
  repairRequestId         String   @map("repair_request_id") @db.Uuid
  /// 줄 단위 이벤트(수선요청)면 그 줄
  repairRequestItemId     String?  @map("repair_request_item_id") @db.Uuid
  /// 유닛 단위 이벤트(입고·출고)면 그 유닛
  repairRequestItemUnitId String?  @map("repair_request_item_unit_id") @db.Uuid
  previousStatus          String?  @map("previous_status") @db.VarChar(25)
  newStatus               String   @map("new_status") @db.VarChar(25)
  eventDate               DateTime @map("event_date") @db.Date
  notes                   String?  @map("notes")
  actorId                 String   @map("actor_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  repairRequest RepairRequest          @relation(fields: [repairRequestId], references: [id])
  item          RepairRequestItem?     @relation(fields: [repairRequestItemId], references: [id], onDelete: Cascade)
  unit          RepairRequestItemUnit? @relation(fields: [repairRequestItemUnitId], references: [id], onDelete: Cascade)
  actor         User                   @relation("RepairStatusEventActor", fields: [actorId], references: [id])

  @@index([repairRequestId, eventDate])
  @@map("repair_status_events")
}

// -----------------------------------------------------------------------------
// 6. 알림·운영
// -----------------------------------------------------------------------------

model NotificationTemplate {
  id             String   @id @db.Uuid
  code           String   @unique @map("code") @db.VarChar(60)
  name           String   @map("name") @db.VarChar(120)
  channel        String   @map("channel") @db.VarChar(20)
  body           String   @map("body")
  approvalStatus String   @map("approval_status") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rules         NotificationRule[]
  histories     NotificationHistory[]
  journeyStages JourneyStage[]

  @@map("notification_templates")
}

model NotificationRule {
  id          String   @id @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  triggerType String   @map("trigger_type") @db.VarChar(40)
  autoSend    Boolean  @default(false) @map("auto_send")
  active      Boolean  @default(true) @map("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  template NotificationTemplate @relation(fields: [templateId], references: [id])

  @@index([triggerType])
  @@map("notification_rules")
}

model NotificationHistory {
  id             String    @id @db.Uuid
  templateId     String?   @map("template_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  orderId        String?   @map("order_id") @db.Uuid
  recipientPhone String    @map("recipient_phone") @db.VarChar(30)
  /**
   * 실제 발송 채널. 템플릿 채널과 다를 수 있다(알림톡 실패 → SMS 대체).
   */
  channel        String    @default("ALIMTALK") @map("channel") @db.VarChar(20)
  /**
   * 변수 치환까지 끝난 실제 발송 본문.
   */
  body           String?   @map("body")
  status         String    @default("REQUESTED") @map("status") @db.VarChar(20)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  errorMessage   String?   @map("error_message")
  /**
   * 재시도·대체 발송의 원본 이력.
   */
  retryOfId      String?   @map("retry_of_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  template              NotificationTemplate?  @relation(fields: [templateId], references: [id])
  customer              Customer               @relation(fields: [customerId], references: [id])
  order                 Order?                 @relation(fields: [orderId], references: [id])
  retryOf               NotificationHistory?   @relation("NotificationRetry", fields: [retryOfId], references: [id])
  retries               NotificationHistory[]  @relation("NotificationRetry")
  journeyEvents         JourneyEvent[]
  rentalAllocationNotes RentalAllocationNote[]

  @@index([customerId, createdAt(sort: Desc)])
  @@map("notification_history")
}

model SharedNote {
  id           String    @id @db.Uuid
  content      String    @map("content")
  targetUserId String?   @map("target_user_id") @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  status       String    @default("ACTIVE") @map("status") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  targetUser User? @relation("SharedNoteTarget", fields: [targetUserId], references: [id])
  author     User  @relation("SharedNoteAuthor", fields: [authorId], references: [id])

  @@map("shared_notes")
}

model DashboardTaskAction {
  id         String   @id @db.Uuid
  taskType   String   @map("task_type") @db.VarChar(30)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.Uuid
  status     String   @default("ACKNOWLEDGED") @map("status") @db.VarChar(20)
  memo       String?  @map("memo")
  actionBy   String   @map("action_by") @db.Uuid
  actionAt   DateTime @map("action_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actionByUser User @relation("DashboardTaskActionActionBy", fields: [actionBy], references: [id])

  @@index([taskType, entityType, entityId])
  @@map("dashboard_task_actions")
}

// -----------------------------------------------------------------------------
// 인프라 (문서 외 추가 테이블)
// -----------------------------------------------------------------------------

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model IdempotencyKey {
  id           String   @id @db.Uuid
  key          String   @unique @map("key") @db.VarChar(120)
  userId       String?  @map("user_id") @db.Uuid
  endpoint     String   @map("endpoint") @db.VarChar(150)
  responseJson Json?    @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id])

  @@map("idempotency_keys")
}

// -----------------------------------------------------------------------------
// 12. 고객 진행 단계 (설계 PDF 1페이지 업무흐름 — 개발설계서 05 G-11)
//
// 사람이 관리하는 표시 레이어다. order_items.status 등 시스템이 계산하는 상태를
// 대체하거나 자동 연동하지 않는다(이중 관리·롤백 충돌 방지). 단계 변경이 곧
// 고객 연락 트리거이며, 발송은 화면의 확인창을 거친다.
// -----------------------------------------------------------------------------

/**
 * 진행 단계 마스터. 시드 고정이되 이름·연락 템플릿 매핑은 관리자가 조정한다.
 */
model JourneyStage {
  id             String   @id @db.Uuid
  /**
   * CUSTOM(비즈니스 맞춤) | RENTAL(웨딩패키지 렌탈)
   */
  trackType      String   @map("track_type") @db.VarChar(20)
  code           String   @map("code") @db.VarChar(30)
  name           String   @map("name") @db.VarChar(60)
  sequenceNo     Int      @map("sequence_no")
  /**
   * 이 단계 진입 시 제안할 알림 템플릿. 없으면 발송 제안 없음
   */
  templateId     String?  @map("template_id") @db.Uuid
  /**
   * AUTO(자동완료·수동버튼 없음) | GATED(품목 전수완료 후 [전체완료] 활성) — v2 D2
   */
  completionMode String   @default("GATED") @map("completion_mode") @db.VarChar(10)
  /**
   * 게이팅 대상 품목 범위. ORDER_ITEMS(주문 품목) | REPAIR_ITEMS(수선요청) | NONE(AUTO 단계)
   */
  targetScope    String   @default("ORDER_ITEMS") @map("target_scope") @db.VarChar(20)
  active         Boolean  @default(true) @map("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  template NotificationTemplate? @relation(fields: [templateId], references: [id])
  events   JourneyEvent[]

  @@unique([trackType, code])
  @@unique([trackType, sequenceNo])
  @@map("journey_stages")
}

/**
 * 거래 1건의 진행. 계약 전에는 orderId가 비어 있다.
 */
model CustomerJourney {
  id                    String    @id @db.Uuid
  customerId            String    @map("customer_id") @db.Uuid
  orderId               String?   @map("order_id") @db.Uuid
  /**
   * REPAIR 트랙의 원천 수선요청. 수선 접수 시 자동 생성되며, CUSTOM/RENTAL 진행에서는 비어 있다.
   * (설계서 02 §7.2 — 수선 대상은 order가 아니라 RepairRequest이므로 orderId 대신 이 참조로 대상을 해석한다)
   */
  sourceRepairRequestId String?   @unique @map("source_repair_request_id") @db.Uuid
  trackType             String    @map("track_type") @db.VarChar(20)
  currentStageCode      String    @map("current_stage_code") @db.VarChar(30)
  /**
   * ACTIVE | COMPLETED | CANCELLED
   */
  status                String    @default("ACTIVE") @map("status") @db.VarChar(20)
  startedAt             DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(6)
  rowVersion            Int       @default(0) @map("row_version")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer            Customer                     @relation(fields: [customerId], references: [id])
  order               Order?                       @relation(fields: [orderId], references: [id])
  sourceRepairRequest RepairRequest?               @relation("RepairJourney", fields: [sourceRepairRequestId], references: [id])
  events              JourneyEvent[]
  itemCompletions     JourneyStageItemCompletion[]

  @@index([customerId, startedAt(sort: Desc)])
  @@index([status, currentStageCode])
  @@map("customer_journeys")
}

/**
 * 진행 단계별 "품목별 완료" 기록 (v2 D2 / 설계서 02 §3.3).
 * 존재 = 그 단계에서 해당 품목이 담당자에 의해 완료 처리됨.
 * production/rental/repair 상태와 자동 연동하지 않는다(힌트만) — v1 비연동 원칙과
 * PDF 게이팅을 동시에 만족시키는 지점.
 */
model JourneyStageItemCompletion {
  id          String    @id @db.Uuid
  journeyId   String    @map("journey_id") @db.Uuid
  stageCode   String    @map("stage_code") @db.VarChar(30)
  /**
   * ORDER_ITEM | REPAIR_ITEM — 트랙에 따라 대상이 다르다(다형 참조, FK 없음·앱 검증)
   */
  targetType  String    @map("target_type") @db.VarChar(20)
  targetId    String    @map("target_id") @db.Uuid
  completedAt DateTime  @map("completed_at") @db.Timestamptz(6)
  completedBy String    @map("completed_by") @db.Uuid
  notes       String?   @map("notes")
  /**
   * 완료 취소(되돌리기) 시 채운다 — 물리삭제 금지. 집계는 revokedAt IS NULL만 센다.
   */
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  journey         CustomerJourney @relation(fields: [journeyId], references: [id])
  completedByUser User            @relation("JourneyItemCompletionActor", fields: [completedBy], references: [id])

  @@unique([journeyId, stageCode, targetType, targetId])
  @@index([journeyId, stageCode])
  @@map("journey_stage_item_completions")
}

/**
 * 단계 변경 이력 + 그 시점의 고객 연락 처리 결과
 */
model JourneyEvent {
  id                    String   @id @db.Uuid
  journeyId             String   @map("journey_id") @db.Uuid
  stageId               String   @map("stage_id") @db.Uuid
  fromStageCode         String?  @map("from_stage_code") @db.VarChar(30)
  toStageCode           String   @map("to_stage_code") @db.VarChar(30)
  /**
   * 되돌리기(후진) 시 필수
   */
  reason                String?  @map("reason")
  notes                 String?  @map("notes")
  /**
   * NONE | SENT | DEFERRED | SKIPPED — 이 변경 시점의 고객 연락 처리 결과
   */
  notificationOutcome   String   @default("NONE") @map("notification_outcome") @db.VarChar(20)
  notificationHistoryId String?  @map("notification_history_id") @db.Uuid
  actorId               String   @map("actor_id") @db.Uuid
  changedAt             DateTime @map("changed_at") @db.Timestamptz(6)

  journey             CustomerJourney      @relation(fields: [journeyId], references: [id])
  stage               JourneyStage         @relation(fields: [stageId], references: [id])
  notificationHistory NotificationHistory? @relation(fields: [notificationHistoryId], references: [id])
  actor               User                 @relation("JourneyEventActor", fields: [actorId], references: [id])

  @@index([journeyId, changedAt(sort: Desc)])
  @@index([notificationOutcome])
  @@map("journey_events")
}
